# ---------------------------------------------------------------------------
# Feishu Open Platform credentials (https://open.feishu.cn/app -> 凭证与基础信息)
# ---------------------------------------------------------------------------
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Callback URL - must be added in 开发配置 -> 安全设置 -> 重定向 URL
FEISHU_REDIRECT_URI=http://127.0.0.1:5000/oauth/callback
# Space-separated OAuth scopes; request each one in 权限管理 first.
FEISHU_SCOPES=auth:user.id:read task:task:read task:task:write im:chat:readonly calendar:calendar:readonly wiki:wiki:readonly base:table:read base:record:retrieve base:record:create im:message:readonly im:message.group_msg:get_as_user contact:contact.base:readonly contact:user.email:readonly offline_access
# FEISHU_WIKI_NODE_TOKEN=WBJjwtT7TizbTekjBPMcMxT5nbe  # wiki URL token (feishu.cn/wiki/<token>); resolved to the Bitable app_token automatically
# FEISHU_BITABLE_APP_TOKEN=xxxxxxxx  # or paste the app_token from a direct base URL (feishu.cn/base/<app_token>)
# Website task writes (needs base:record:create + base:record:update + base:field:read scopes):
# FEISHU_BITABLE_SUBMIT_TABLE_ID=tbl...   # new tasks POST here (use the tracked 任务管理表 id to make them appear on the board)
# FEISHU_BITABLE_TASKS_TABLE_ID=tbl...    # cancel/complete PATCH here (任务管理表)
# Optional column-name overrides (defaults match the RoboMaster base):
# FEISHU_BITABLE_NAME_FIELD=任务名称
# FEISHU_BITABLE_TYPE_FIELD=兵种类型
# FEISHU_BITABLE_DIVISION_FIELD=研发组别
# FEISHU_BITABLE_REQUIREMENT_FIELD=任务需求（兵种组长填写）（务必详细！）
# FEISHU_BITABLE_DESC_FIELD=备注
# FEISHU_BITABLE_DDL_FIELD=ddl
# FEISHU_BITABLE_PRIORITY_FIELD=优先级
# FEISHU_BITABLE_OWNER_FIELD=负责人
# FEISHU_BITABLE_STATUS_FIELD=任务状态（由技术组长验收）
# FEISHU_BITABLE_DEFAULT_STATUS=待执行
# RM_AUTO_COLLECT_SECONDS=300   # background auto-collect (0 = disabled; prefer cron in production)
# FEISHU_MODE=live | mock   (mock = offline; seeds from RM_MOCK_DATA_DIR / data)
FEISHU_MODE=live

# Optional collection scope (keep empty to collect everything reachable)
# FEISHU_CHAT_IDS=oc_xxxxxxxx oc_yyyyyyyy
# FEISHU_CALENDAR_ID=
# FEISHU_BITABLE_APP_TOKEN=
# FEISHU_TENANT_NAME=RoboMaster Research Team

# ---------------------------------------------------------------------------
# Web
# ---------------------------------------------------------------------------
FLASK_SECRET_KEY=change-me-in-production
HOST=127.0.0.1
PORT=5000
# Comma-separated open_ids allowed to manage tasks / run sync (empty = first
# user who logs in becomes admin)
FEISHU_ADMIN_OPEN_IDS=

# ---------------------------------------------------------------------------
# Email notifications (leave SMTP_* empty for dry-run: notifications are
# still recorded on the site but not delivered)
# ---------------------------------------------------------------------------
NOTIFY_EMAIL_FROM=rmtasks@example.com
NOTIFY_EMAIL_TO=manager@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=1
SMTP_SSL=0
# Send email on task create/cancel/complete events
NOTIFY_ON_TASK_CHANGE=1
